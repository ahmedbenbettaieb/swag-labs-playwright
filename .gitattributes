# Normalize line endings for text files in the repository
* text=auto eol=lf

# Force LF for source and config
*.ts      text eol=lf diff=typescript
*.js      text eol=lf diff=javascript
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Keep generated artifacts out of diffs / language stats
package-lock.json linguist-generated=true
test-results/** linguist-generated=true
playwright-report/** linguist-generated=true

# Binary assets
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webm    binary
*.zip     binary
*.woff    binary
*.woff2   binary
